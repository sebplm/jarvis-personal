# ─────────────────────────────────────────────────────────────
# Jarvis Personnel — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────────────────────
# IMPORTANT : ne jamais committer le fichier .env sur GitHub !
# Il est déjà dans .gitignore.

# ── LLM ──────────────────────────────────────────────────────
# Clé API Anthropic (Claude Sonnet 4.6)
# Obtenir sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GOOGLE (Calendar + Gmail) ─────────────────────────────────
# Créer un projet sur https://console.cloud.google.com
# Activer les APIs : Google Calendar API, Gmail API
# Créer des identifiants OAuth 2.0 (type "Application de bureau")
# Télécharger le JSON et copier client_id + client_secret ci-dessous

# Format : CLIENT_ID:CLIENT_SECRET  (coller dans "jarvis connect gcalendar")
GOOGLE_CLIENT_ID_PERSO=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_PERSO=GOCSPX-xxxxxxxxxxxxxxxx

GOOGLE_CLIENT_ID_MENTORSHOW=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_MENTORSHOW=GOCSPX-xxxxxxxxxxxxxxxx

# ── SLACK ─────────────────────────────────────────────────────
# Créer une app Slack sur https://api.slack.com/apps
# Permissions OAuth nécessaires :
#   channels:history, channels:read, chat:write, im:history, im:read, users:read
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WHATSAPP ──────────────────────────────────────────────────
# Via WhatsApp Business Cloud API (Meta for Developers)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_VERIFY_TOKEN=mon_token_secret_jarvis

# ── iMESSAGE / SMS ────────────────────────────────────────────
# Aucune clé requise — lecture directe de ~/Library/Messages/chat.db
# Jarvis doit avoir l'accès "Accès complet au disque" dans
# Préférences Système > Confidentialité & Sécurité

# ── MÉTÉO (optionnel) ─────────────────────────────────────────
# https://openweathermap.org/api (gratuit)
# OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── RECHERCHE WEB (optionnel) ─────────────────────────────────
# https://serpapi.com
# SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
